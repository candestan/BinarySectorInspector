{
  "schema_version": 1,
  "id": "compiler.autohotkey.generic",
  "name": "AutoHotkey",
  "category": "compiler",
  "vendor": "AutoHotkey",
  "product_key": "autohotkey",
  "confidence": "high",
  "native_only": true,
  "author": "candestan",
  "reference": "https://www.autohotkey.com/",
  "description": "AutoHotkey compiled-script identity. Ahk2Exe stubs are MSVC and still carry a Rich header; that is not the compiler of the script. Script bytes live in overlay or RCDATA, while runtime markers often sit in .rdata.",
  "conditions": {
    "any": [
      {
        "version_string": {
          "key": "ProductName",
          "contains": "AutoHotkey"
        }
      },
      {
        "version_string": {
          "key": "OriginalFilename",
          "contains": "Ahk2Exe"
        }
      },
      { "string_contains": "This script requires AutoHotkey" },
      {
        "all": [
          { "overlay": { "min_size": 16 } },
          {
            "any": [
              {
                "byte_pattern": "3E 41 55 54 4F 48 4F 54 4B 45 59 20 53 43 52 49 50 54 3C",
                "where": "file",
                "weight": 80
              },
              {
                "byte_pattern": "3E 41 55 54 4F 48 4F 54 4B 45 59 20 53 43 52 49 50 54 3C",
                "where": "overlay",
                "weight": 80
              },
              { "string_contains": ">AUTOHOTKEY SCRIPT<" },
              { "string_contains": "autohotkey.com" },
              { "string_contains": "Ahk2Exe" }
            ]
          }
        ]
      },
      {
        "all": [
          { "resource_type": "RCDATA" },
          {
            "any": [
              { "resource_name": ">AUTOHOTKEY SCRIPT<" },
              {
                "byte_pattern": "3E 41 55 54 4F 48 4F 54 4B 45 59 20 53 43 52 49 50 54 3C",
                "where": "file",
                "weight": 80
              }
            ]
          }
        ]
      }
    ]
  }
}
