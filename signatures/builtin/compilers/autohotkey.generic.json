{
  "schema_version": 1,
  "id": "compiler.autohotkey.generic",
  "name": "AutoHotkey",
  "category": "compiler",
  "vendor": "AutoHotkey",
  "product_key": "autohotkey",
  "confidence": "high",
  "native_only": true,
  "author": "candestan",
  "reference": "https://www.autohotkey.com/",
  "description": "AutoHotkey compiled-script identity. Ahk2Exe stubs still carry a Microsoft Rich header; that is not the compiler of the script.",
  "conditions": {
    "any": [
      { "string_contains": "autohotkey.com" },
      { "string_contains": "AutoHotkey" },
      { "string_contains": "Ahk2Exe" },
      { "string_contains": ">AUTOHOTKEY SCRIPT<" },
      { "string_contains": "This script requires AutoHotkey" },
      {
        "byte_pattern": "41 00 75 00 74 00 6F 00 48 00 6F 00 74 00 6B 00 65 00 79 00",
        "where": "file",
        "weight": 70
      },
      {
        "byte_pattern": "41 75 74 6F 48 6F 74 6B 65 79",
        "where": "file",
        "weight": 55
      },
      {
        "byte_pattern": "3E 41 55 54 4F 48 4F 54 4B 45 59 20 53 43 52 49 50 54 3C",
        "where": "file",
        "weight": 80
      },
      {
        "version_string": {
          "key": "ProductName",
          "contains": "AutoHotkey"
        }
      },
      {
        "version_string": {
          "key": "OriginalFilename",
          "contains": "Ahk2Exe"
        }
      }
    ]
  }
}
